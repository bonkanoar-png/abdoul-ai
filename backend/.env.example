# Runtime
APP_ENV=development
APP_DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL — local development values only
POSTGRES_DB=abdoul_ai
POSTGRES_USER=abdoul_ai
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://abdoul_ai:change-me-local-only@postgres:5432/abdoul_ai

# Admin CMS — replace every value outside local development
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_JWT_EXPIRE_MINUTES=30
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-long-temporary-password
ADMIN_COOKIE_NAME=access_token
ADMIN_COOKIE_SECURE=false
UPLOAD_DIRECTORY=/app/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=["application/pdf","image/png","image/jpeg","image/webp"]
PUBLIC_UPLOAD_BASE_URL=/uploads

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
