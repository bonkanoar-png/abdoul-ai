# Application
APP_NAME=abdoul-ai
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_DB=abdoul_ai
POSTGRES_USER=abdoul_ai
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://abdoul_ai:change-me-local-only@postgres:5432/abdoul_ai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI providers (leave empty unless a local environment requires them)
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Storage
STORAGE_PROVIDER=local

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
