# Backend origin used by the current server-only data services.
# Local host execution uses localhost. Compose injects http://backend:8000
# at build and runtime so the Next.js container resolves FastAPI internally.
# Keep this value free of paths and trailing slashes. Before adding browser-side
# requests, introduce a public proxy or separate server and browser API URLs.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical public origin used for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production examples belong in the root .env.production.example used by Compose.
# NEXT_PUBLIC_* values are public build-time configuration and must never contain secrets.
# The future browser-facing API origin is the same-origin proxy, for example
# https://portfolio.example.com/api. Current server-only services use the internal proxy URL.
