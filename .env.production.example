# Copy to .env.production outside version control and replace every required value.
# Never commit the resulting .env.production file.
POSTGRES_DB=abdoul_ai
POSTGRES_USER=abdoul_ai
POSTGRES_PASSWORD=

PUBLIC_SITE_URL=https://portfolio.example.com
PUBLIC_API_URL=https://portfolio.example.com/api

# Reverse proxy listeners. Restrict PROXY_BIND_ADDRESS at the host firewall too.
PROXY_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
